# Copy to .env (git-ignored) for `mise run test:integration`.

# Xen Orchestra, same variables as xo-gocli.
XOA_ENDPOINT=https://xo.example.org
XOA_TOKEN=
# true only for a self-signed certificate.
XOA_INSECURE=false

# A cloud-init template with the guest tools, and its default user.
XO_TEST_TEMPLATE=
XO_TEST_USER=debian
# The pool is required when the template exists in several pools; the
# network must have DHCP and be reachable over SSH from this machine.
XO_TEST_POOL=
XO_TEST_NETWORK=
